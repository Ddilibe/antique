---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { getFeaturedJournal, getPublishedJournal, getPublishedNotes, entryReadingTime } from '../lib/content';
import { formatDate, isoDate, slugify } from '../lib/utils';
import { ISSUE, SITE } from '../consts';

const [journal, notes] = await Promise.all([getPublishedJournal(), getPublishedNotes()]);
const featured = await getFeaturedJournal();
const rest = journal.filter((entry) => entry.id !== featured?.id).slice(0, 4);
const recentNotes = notes.slice(0, 4);

const renderedNotes = await Promise.all(
  recentNotes.map(async (note) => ({ note, ...(await render(note)) })),
);

const totalWords = journal.reduce((sum, entry) => {
  const body = entry.body ?? '';
  return sum + body.trim().split(/\s+/).filter(Boolean).length;
}, 0);
---

<BaseLayout description={SITE.description}>
  <section class="hero">
    <div class="container hero__inner">
      <div>
        <p class="eyebrow">Issue {ISSUE.number} · {ISSUE.season} {ISSUE.year}</p>
        <h1 class="hero__title">A quiet place for <em>loud thoughts</em>.</h1>
        <p class="hero__lede">
          Antique is a personal journal and an independent publication — essays and fragments on
          attention, memory, and the slow work of being alive.
        </p>
      </div>

      <aside class="hero__aside">
        <p>
          Written at a desk, revised by hand, and published without hurry. New work appears when it
          is ready, not when a calendar says so.
        </p>
        <dl>
          <dt>In the journal</dt>
          <dd>{journal.length} essays</dd>
          <dt>In the margins</dt>
          <dd>{notes.length} notes</dd>
          <dt>Words so far</dt>
          <dd>{totalWords.toLocaleString('en-US')}</dd>
        </dl>
      </aside>
    </div>
  </section>

  {featured && (
    <section class="section section--tight">
      <div class="container">
        <div class="section-head">
          <h2 class="section-head__title">From the desk</h2>
          <a class="section-head__link" href="/journal">All essays →</a>
        </div>

        <article class="featured">
          <div>
            <div class="meta">
              <time datetime={isoDate(featured.data.date)}>{formatDate(featured.data.date)}</time>
              <span class="meta__dot" aria-hidden="true"></span>
              <span>{entryReadingTime(featured)} min read</span>
            </div>
            <h3 class="featured__title">
              <a href={`/journal/${featured.id}/`}>{featured.data.title}</a>
            </h3>
            <p class="featured__description">{featured.data.description}</p>
            <div class="featured__foot">
              <div class="cluster">
                {featured.data.tags.map((tag) => (
                  <a class="tag" href={`/tags/${slugify(tag)}/`}>{tag}</a>
                ))}
              </div>
              <a class="button button--ghost" href={`/journal/${featured.id}/`}>Read the essay</a>
            </div>
          </div>

          {featured.data.epigraph && (
            <blockquote class="featured__epigraph">
              <p>{featured.data.epigraph}</p>
              {featured.data.epigraphAuthor && <cite>{featured.data.epigraphAuthor}</cite>}
            </blockquote>
          )}
        </article>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="section-head__title">Recent essays</h2>
        <a class="section-head__link" href="/archive">Full archive →</a>
      </div>

      <div class="post-grid">
        {rest.map((entry) => <PostCard entry={entry} />)}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="section-head">
        <h2 class="section-head__title">Notes &amp; marginalia</h2>
        <a class="section-head__link" href="/notes">All notes →</a>
      </div>

      <div class="note-list">
        {renderedNotes.map(({ note, Content }) => (
          <article class="note">
            <time class="note__date" datetime={isoDate(note.data.date)}>
              {formatDate(note.data.date, 'month-day')}
            </time>
            <div>
              {note.data.title && (
                <h3 class="note__title">
                  <a href={`/notes/${note.id}/`}>{note.data.title}</a>
                </h3>
              )}
              <div class="note__body"><Content /></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Newsletter />
    </div>
  </section>
</BaseLayout>
