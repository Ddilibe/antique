---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedNotes, type NoteEntry } from '../../lib/content';
import { formatDate, isoDate, slugify } from '../../lib/utils';

export async function getStaticPaths() {
  const notes = await getPublishedNotes();

  return notes.map((note, index) => ({
    params: { slug: note.id },
    props: {
      note,
      newer: index > 0 ? notes[index - 1] : undefined,
      older: index < notes.length - 1 ? notes[index + 1] : undefined,
    },
  }));
}

interface Props {
  note: NoteEntry;
  newer?: NoteEntry;
  older?: NoteEntry;
}

const { note, newer, older } = Astro.props;
const { Content } = await render(note);
const { title, date, tags, source, sourceHref } = note.data;
---

<BaseLayout
  title={title ?? `Note — ${formatDate(date)}`}
  description={note.body ? note.body.slice(0, 160) : 'A note from Antique.'}
  type="article"
  publishedTime={date.toISOString()}
>
  <article class="container" data-pagefind-body>
    <div class="note-page">
      <a class="post-header__back" href="/notes" data-pagefind-ignore>← All notes</a>
      <time class="note-page__date" datetime={isoDate(date)}>{formatDate(date)}</time>

      {title && <h1 class="post-header__title" style="font-size: var(--step-3);">{title}</h1>}

      <div class="prose note-page__body">
        <Content />
      </div>

      {source && (
        <p class="note__source" style="margin-top: 2rem;">
          Source:{' '}
          {sourceHref ? (
            <a href={sourceHref} rel="noopener noreferrer" target="_blank">{source}</a>
          ) : (
            source
          )}
        </p>
      )}

      {tags.length > 0 && (
        <div class="post-end">
          <p class="eyebrow">Tags</p>
          <div class="post-end__tags">
            {tags.map((tag) => (
              <a class="tag" href={`/tags/${slugify(tag)}/`}>{tag}</a>
            ))}
          </div>
        </div>
      )}

      <nav class="post-end__foot" aria-label="More notes" data-pagefind-ignore>
        {newer ? (
          <a class="button button--ghost" href={`/notes/${newer.id}/`}>← Newer</a>
        ) : (
          <span></span>
        )}
        {older && <a class="button button--ghost" href={`/notes/${older.id}/`}>Older →</a>}
      </nav>
    </div>
  </article>
</BaseLayout>
