---
import type { JournalEntry } from '../lib/content';
import { entryReadingTime } from '../lib/content';
import { formatDate, isoDate, slugify } from '../lib/utils';

interface Props {
  entry: JournalEntry;
  compact?: boolean;
}

const { entry, compact = false } = Astro.props;
const { title, description, date, tags } = entry.data;
const minutes = entryReadingTime(entry);
---

<article class:list={['post-card', compact && 'post-card--compact']}>
  <div class="meta">
    <time datetime={isoDate(date)}>{formatDate(date)}</time>
    <span class="meta__dot" aria-hidden="true"></span>
    <span>{minutes} min read</span>
  </div>

  <h3 class="post-card__title">
    <a href={`/journal/${entry.id}/`}>{title}</a>
  </h3>

  {!compact && <p class="post-card__description">{description}</p>}

  {tags.length > 0 && (
    <div class="post-card__foot">
      {tags.slice(0, 3).map((tag) => (
        <a class="tag" href={`/tags/${slugify(tag)}/`}>{tag}</a>
      ))}
    </div>
  )}
</article>
